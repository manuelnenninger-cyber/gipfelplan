{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/proxy/brouter/:path*", "destination": "https://brouter.de/:path*" },
    { "source": "/proxy/ovp-main/:path*", "destination": "https://overpass-api.de/:path*" },
    { "source": "/proxy/ovp-alt/:path*", "destination": "https://overpass.private.coffee/:path*" },
    { "source": "/proxy/ovp-kumi/:path*", "destination": "https://overpass.kumi.systems/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
